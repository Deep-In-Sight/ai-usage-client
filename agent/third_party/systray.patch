+// Added to the upstream v1.12.2 code; see PATCHED.md.
+func SetLabel(label, guide string) {
+	instance.lock.Lock()
+	instance.label, instance.labelGuide = label, guide
+	props := instance.props
+	conn := instance.conn
+	defer instance.lock.Unlock()
