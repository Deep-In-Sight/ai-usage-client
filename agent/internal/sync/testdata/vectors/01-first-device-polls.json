{
  "name": "01-first-device-polls",
  "description": "A signed-in device that syncs first becomes the poller and is told to fetch at once",
  "ingest_key": "test-ingest-key-0123456789",
  "server": {
    "server_urls": [
      "http://ai-usage.local",
      "http://ai-usage.local:8700",
      "http://192.0.2.10:8700"
    ],
    "client_latest_version": null
  },
  "steps": [
    {
      "at": "2026-01-05T09:00:00.000Z",
      "request": {
        "headers": {
          "Authorization": "Bearer test-ingest-key-0123456789"
        },
        "body": {
          "schema": 1,
          "client": {
            "version": "1.0.0",
            "os": "linux",
            "os_version": "24.04",
            "arch": "amd64",
            "mode": "headless"
          },
          "device": {
            "id": "dev-a",
            "hostname": "TEST-PC-A",
            "os_user": "user-a"
          },
          "account": {
            "uuid": "acc-1",
            "email": "user-a@example.com",
            "display_name": "User A",
            "organization_name": "Example",
            "organization_type": "claude_max",
            "subscription_type": "max",
            "rate_limit_tier": "default_claude_max_20x"
          },
          "auth": {
            "state": "ok",
            "token_expires_at": "2026-01-05T17:00:00.000Z"
          },
          "results": [],
          "want_fresh": false
        }
      },
      "response": {
        "status": 200,
        "body": {
          "role": "poller",
          "fetch_now": true,
          "next_sync_seconds": 60,
          "latest": null,
          "peers": {
            "devices": 1,
            "poller_hostname": "TEST-PC-A"
          },
          "server_urls": [
            "http://ai-usage.local",
            "http://ai-usage.local:8700",
            "http://192.0.2.10:8700"
          ],
          "client_latest_version": null
        }
      }
    }
  ]
}
