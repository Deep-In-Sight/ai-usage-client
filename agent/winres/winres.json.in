{
  "RT_GROUP_ICON": {
    "APP": {
      "0000": "icon.png"
    }
  },
  "RT_MANIFEST": {
    "#1": {
      "0409": {
        "identity": {
          "name": "DeepInSight.ClaudeUsage",
          "version": "@FILE_VERSION@"
        },
        "description": "Claude Usage agent",
        "minimum-os": "win10",
        "execution-level": "as invoker",
        "ui-access": false,
        "auto-elevate": false,
        "dpi-awareness": "per monitor v2",
        "disable-theming": false,
        "disable-window-filtering": false,
        "high-resolution-scrolling-aware": false,
        "ultra-high-resolution-scrolling-aware": false,
        "long-path-aware": false,
        "printer-driver-isolation": false,
        "gdi-scaling": false,
        "segment-heap": false,
        "use-common-controls-v6": true
      }
    }
  },
  "RT_VERSION": {
    "#1": {
      "0000": {
        "fixed": {
          "file_version": "@FILE_VERSION@",
          "product_version": "@FILE_VERSION@"
        },
        "info": {
          "0409": {
            "CompanyName": "Deep-In-Sight",
            "FileDescription": "Claude Usage agent",
            "FileVersion": "@FILE_VERSION@",
            "InternalName": "claude-usage",
            "LegalCopyright": "Copyright (c) Deep-In-Sight",
            "OriginalFilename": "claude-usage.exe",
            "ProductName": "Claude Usage",
            "ProductVersion": "@PRODUCT_VERSION@",
            "Comments": "Reports Claude plan usage to your team's server. Source: https://github.com/Deep-In-Sight/ai-usage-client"
          }
        }
      }
    }
  }
}
