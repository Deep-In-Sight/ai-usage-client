# Byte-exact files (no CRLF conversion on Windows checkouts): the embedded
# licence notices must equal the repository's LICENSE and the modules'
# files, and the systray copy must equal upstream plus
# agent/third_party/systray.patch.
/LICENSE -text
agent/internal/notices/licenses/** -text
agent/internal/notices/borrowed/** -text
agent/third_party/systray/** -text
# Golden files the tests compare byte for byte.
agent/internal/tray/testdata/** -text
# The usage panel's GNOME extension: tools/mkext generates the agent's
# embedded copies from it, which are compared byte for byte.
gnome-extension/** -text
agent/internal/gnomeext/gnome42/** -text
agent/internal/gnomeext/gnome46/** -text
